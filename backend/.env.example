# ===========================================
# CareCompass AI — Environment Configuration
# ===========================================
# Copy this to .env and fill in your values.
# NEVER commit .env to version control!

# --- Google Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- TinyFish API ---
TINYFISH_API_KEY=your_tinyfish_api_key_here

# --- App Settings ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Security ---
JWT_SECRET_KEY=change_this_to_a_random_secret_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=15

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=100

# --- Redis (optional, for session caching) ---
# --- Supabase (recommended database) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here   # server-side only


REDIS_URL=redis://localhost:6379/0

# --- Data Paths ---
TRIAGE_DATASET_PATH=../triage_dataset.jsonl
CAREGIVERS_PATH=../caregivers.csv
